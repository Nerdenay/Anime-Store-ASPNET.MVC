@using Staj_Projesi_1.Models.Classes
@model List<SalesAction>
@{
	Layout = "~/Views/Shared/Admin_Layout.cshtml";
}

<h2> Buyer Info </h2>

<ol class="breadcrumb mb-4">

	<li class="breadcrumb-item active">Buyer Name: @ViewBag.buyer </li>

</ol>

<table class=" table table-condensed">
	<tr>
		<th>SALE ID</th>
		<th>PRODUCT ID</th>
		<th>EMPLOYEE</th>
		<th>PRICE</th>
		<th>AMOUNT</th>
		<th>TOTAL</th>
		<th>DATE</th>
		<th>PRINT</th>
	</tr>

	@foreach (var x in Model)
	{
		<tr>
			<td>@x.SaleId</td>
			<td>@x.ProductID</td>   <!-- İlişkili Product verisi -->
			<td>@x.EmployeeID</td>   <!-- İlişkili Employee verisi -->
			<td>@x.price</td>
			<td>@x.Amount</td>
			<td>@x.TotalSale</td>
			<td>@x.Date</td>

			<td> <a href="#" class="btn btn-check" style="background-color:slateblue"> Print </a></td>
		</tr>
	}

</table>
