@using Staj_Projesi_1.Models.Classes;
@model List<Employee>
@{
	Layout = "~/Views/Shared/Admin_Layout.cshtml";
}
<h2>Employee</h2>

<table class="table table-bordered" style=" margin-top:20px;">

    <tr>

        <th>ID</th>
        <th>EmployeeName</th>
        <th>Surname</th>
        <th>Picture</th>
        <th>Department</th>
        <th>Update</th>
       

    </tr>

    @foreach (var k in Model)
    {
        <tr>
            <td>@k.EmployeeID</td>
            <td>@k.EmployeeName</td>
            <td>@k.EmployeeSurname</td>
            <td>@k.EmployeePic</td>
            <td>@k.DepartmentID</td>
            
            <td><a href="/Employee/UpdateEmployee/@k.EmployeeID" class="btn btn-default" style="background-color:brown"> Update </a></td>
            <td><a href="/Department/DepartmentEmployeeSale/@k.EmployeeID" class="btn btn-default" style="background-color:burlywood"> Info </a></td>
        </tr>
    }

</table>

<a href="/Employee/AddEmployee" class="btn btn-info"> Add Employee</a>