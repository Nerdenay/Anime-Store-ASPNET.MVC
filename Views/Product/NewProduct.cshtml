@model Staj_Projesi_1.Models.Classes.Products


@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "~/Views/Shared/Admin_Layout.cshtml";
}
<br />
<h2> New Product Page</h2>
<br />

<form class="form-group" method="post">
    @Html.LabelFor(x => x.ProductName)
    @Html.TextBoxFor(x => x.ProductName, new { @class = "form-control" })
    <br />
    @Html.LabelFor(x => x.ProductBrand)
    @Html.TextBoxFor(x => x.ProductBrand, new { @class = "form-control" })
    <br />
    @Html.LabelFor(x => x.Stock)
    @Html.TextBoxFor(x => x.Stock, new { @class = "form-control" })
    <br />
    @Html.LabelFor(x => x.PurchasePrice)
    @Html.TextBoxFor(x => x.PurchasePrice, new { @class = "form-control" })
    <br />
    @Html.LabelFor(x => x.SalePrice)
    @Html.TextBoxFor(x => x.SalePrice, new { @class = "form-control" })
    <br />
    @Html.LabelFor(x => x.Category.CategoryID)
    @Html.DropDownListFor(x=>x.Category.CategoryID,(List<SelectListItem>)ViewBag.Vlu1, new {@class = "form-control" })
   @*  @Html.TextBoxFor(x => x.Category.CategoryID, new { @class = "form-control" }) *@
    <br />
    @Html.LabelFor(x => x.ProductPic)
    @Html.TextBoxFor(x => x.ProductPic, new { @class = "form-control" })
    <br />
    @Html.LabelFor(x => x.Condition)
    @Html.TextBoxFor(x => x.Condition, new { @class = "form-control" })
    <br />
    <button class=" btn btn-primary"> Save </button>
    
    




</form>