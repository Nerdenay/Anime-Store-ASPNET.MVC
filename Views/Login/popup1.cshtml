


<div class="login-form login-form-left">               <!-- Burada bu kısımları bir daha kullanabilmek için Partiallara böldüm  -->
	<div class="agile-row">
		<h3>New Buyer Form</h3>
		<div class="login-agileits-top">
			<form asp-controller="Login" asp-action="popup1" method="post">
				 @Html.AntiForgeryToken() <!-- CSRF (Cross-Site Request Forgery) korumasını sağlar ve formun güvenli bir şekilde post edilmesini garanti eder. -->
				<input type="text" class="name" name="CurrentName" Placeholder="Full Name" required="" />
				<input type="text" class="name" name="CurrentSurname" Placeholder="Surname" required="" />
				<input type="text" class="name" name="CurrentCity" Placeholder="City" required="" />
				<input type="email" class="email" name="CurrentMail" Placeholder="Email" required="" />
				<input type="password" class="password" name="CurrentPassword" Placeholder="Password" required="" />
				<div class="login-check">
					<label class="checkbox"><input type="checkbox" name="checkbox" checked=""><i> </i> I Accept to the Terms &amp; Conditions </label>
				</div>
				<input type="submit" value="Register">
			</form>
		</div>
	</div>
</div>